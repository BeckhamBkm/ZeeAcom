@model ListingDetailsPageViewModel
@{
    var listing = Model.Listing;
    var pictures = listing.Pictures;
    var rentText = listing.MonthlyRent is { } r ? $"{Currency.Rand(r)} / month" : "Rent on request";
    ViewData["Title"] = $"{listing.Name}, {listing.Suburb}";
    ViewData["Description"] = $"{listing.Name} in {listing.Suburb}. {rentText}.";
    if (pictures.Count > 0)
    {
        ViewData["OgImage"] = pictures[0].Url;
    }
    var enquirySent = TempData["EnquirySent"] is true;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Listings</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-suburb="@listing.Suburb">@listing.Suburb</a></li>
        <li class="breadcrumb-item active" aria-current="page">@listing.Name</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        @if (pictures.Count == 0)
        {
            <img src="/img/no-photo.svg" alt="No photo yet" class="img-fluid rounded w-100" />
        }
        else
        {
            <div id="gallery" class="carousel slide bg-dark rounded overflow-hidden" data-bs-ride="false">
                <div class="carousel-inner">
                    @for (var i = 0; i < pictures.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@pictures[i].Url" alt="@(pictures[i].Caption ?? listing.Name)" class="d-block w-100 gallery-photo"
                                 loading="@(i == 0 ? "eager" : "lazy")" onerror="this.onerror=null;this.src='/img/no-photo.svg';" />
                            @if (!string.IsNullOrEmpty(pictures[i].Caption))
                            {
                                <div class="carousel-caption"><span class="badge text-bg-dark fs-6 fw-normal">@pictures[i].Caption</span></div>
                            }
                        </div>
                    }
                </div>
                @if (pictures.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous photo</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next photo</span>
                    </button>
                }
            </div>
            @if (pictures.Count > 1)
            {
                <div class="d-flex gap-2 mt-2 overflow-auto pb-1">
                    @for (var i = 0; i < pictures.Count; i++)
                    {
                        <button type="button" class="btn p-0 border-0 flex-shrink-0" data-bs-target="#gallery" data-bs-slide-to="@i"
                                aria-label="Show photo @(i + 1)@(pictures[i].Caption is { } c ? $": {c}" : "")">
                            <img src="@(pictures[i].ThumbnailUrl ?? pictures[i].Url)" alt="" class="rounded gallery-thumb" loading="lazy"
                                 onerror="this.onerror=null;this.src='/img/no-photo.svg';" />
                        </button>
                    }
                </div>
            }
        }

        <h1 class="h3 mt-4 mb-1">@listing.Name</h1>
        <p class="text-muted">@listing.Address, @listing.Suburb</p>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <p class="h3 mb-0">
                    @if (listing.MonthlyRent is { } rent)
                    {
                        @Currency.Rand(rent)<span class="fs-6 text-muted"> / month</span>
                    }
                    else
                    {
                        <span class="fs-5 text-muted">Rent on request</span>
                    }
                </p>
                <p class="text-muted small mb-3">Listed by @listing.LandlordFirstName</p>

                <div class="d-grid gap-2">
                    @if (Model.WhatsAppUrl is not null)
                    {
                        <a href="@Model.WhatsAppUrl" class="btn btn-success" target="_blank" rel="noopener">WhatsApp @listing.LandlordFirstName</a>
                    }
                    @if (Model.CallUrl is not null)
                    {
                        <a href="@Model.CallUrl" class="btn btn-outline-primary">Call @listing.LandlordCellPhone</a>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm" id="enquire">
            <div class="card-body">
                <h2 class="h5">Send an enquiry</h2>
                @if (enquirySent)
                {
                    <div class="alert alert-success mb-0" role="status">
                        Thanks! Your message was sent to @listing.LandlordFirstName, who will get back to you.
                    </div>
                }
                else
                {
                    <form method="post" asp-action="Enquire" asp-route-id="@listing.Id" asp-fragment="enquire">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @* Honeypot for bots: hidden from people, must stay empty. *@
                        <div class="visually-hidden" aria-hidden="true">
                            <label for="website">Website</label>
                            <input id="website" name="website" tabindex="-1" autocomplete="off" />
                        </div>

                        <div class="mb-2">
                            <label asp-for="Enquiry.Name" class="form-label"></label>
                            <input asp-for="Enquiry.Name" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Enquiry.Name" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Enquiry.CellPhone" class="form-label"></label>
                            <input asp-for="Enquiry.CellPhone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Enquiry.CellPhone" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Enquiry.Email" class="form-label"></label>
                            <input asp-for="Enquiry.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Enquiry.Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Enquiry.Message" class="form-label"></label>
                            <textarea asp-for="Enquiry.Message" rows="4" class="form-control"
                                      placeholder="e.g. Hi, is this still available? When can I view it?"></textarea>
                            <span asp-validation-for="Enquiry.Message" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send enquiry</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
