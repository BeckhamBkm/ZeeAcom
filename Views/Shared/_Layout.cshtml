<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f3b2e" />
    <title>@ViewData["Title"] - Zee Accom</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description" />
        <meta property="og:description" content="@description" />
    }
    <meta property="og:title" content="@ViewData["Title"] - Zee Accom" />
    <meta property="og:site_name" content="Zee Accom" />
    @if (ViewData["OgImage"] is string ogImage)
    {
        @* Shown when a listing link is shared on WhatsApp/Facebook. Needs an absolute URL. *@
        <meta property="og:image" content="@(ogImage.StartsWith('/') ? $"{Context.Request.Scheme}://{Context.Request.Host}{ogImage}" : ogImage)" />
    }
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    string Active(params string[] names) => names.Contains(controller) ? "active" : "";
}
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-md za-navbar py-2">
            <div class="container">
                <a class="navbar-brand za-brand" asp-controller="Home" asp-action="Index">
                    <span class="za-brand-mark"><i class="bi bi-house-heart-fill" aria-hidden="true"></i></span>
                    <span>Zee Accom<span class="za-brand-dot">.</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-md-1 mt-2 mt-md-0">
                        <li class="nav-item"><a class="nav-link @Active("Listings")" asp-controller="Listings" asp-action="Index"><i class="bi bi-search me-1" aria-hidden="true"></i>Find a place</a></li>
                        @if (User.IsInRole(ZeeAcom.Common.Roles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link @Active("Owners")" asp-controller="Owners" asp-action="Index"><i class="bi bi-people me-1" aria-hidden="true"></i>Owners</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Properties")" asp-controller="Properties" asp-action="Index"><i class="bi bi-buildings me-1" aria-hidden="true"></i>Properties</a></li>
                        }
                        @if (User.IsInRole(ZeeAcom.Common.Roles.Landlord))
                        {
                            <li class="nav-item"><a class="nav-link @Active("Landlord", "Photos")" asp-controller="Landlord" asp-action="Index"><i class="bi bi-grid-1x2 me-1" aria-hidden="true"></i>Dashboard</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 py-md-5 flex-grow-1">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex gap-2" role="alert">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <div>@success</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>@error</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="za-footer pt-5 pb-4 mt-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <a class="za-brand mb-2" asp-controller="Home" asp-action="Index">
                        <span class="za-brand-mark"><i class="bi bi-house-heart-fill" aria-hidden="true"></i></span>
                        <span>Zee Accom<span class="za-brand-dot">.</span></span>
                    </a>
                    <p class="mt-3 mb-0">Rooms, flats and houses to rent in Zeerust, listed by local landlords. Contact them directly; no agents, no fees.</p>
                </div>
                <div class="col-6 col-md-3 offset-md-1">
                    <h2 class="mb-3">Renters</h2>
                    <ul class="list-unstyled mb-0 vstack gap-2">
                        <li><a asp-controller="Listings" asp-action="Index">Browse listings</a></li>
                        <li><a asp-controller="Listings" asp-action="Index" asp-route-sort="RentLowToHigh">Cheapest first</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h2 class="mb-3">Landlords</h2>
                    <ul class="list-unstyled mb-0 vstack gap-2">
                        <li><a asp-controller="Account" asp-action="Register">List your place for free</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Landlord log in</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-light opacity-25 my-4" />
            <div class="small">&copy; @DateTime.Now.Year Zee Accom · Zeerust, North West</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
