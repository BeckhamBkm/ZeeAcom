@model ZeeAcom.Common.Models.ListingModels.ListingModel
@* One property in the public listings grid. *@
<div class="card h-100 listing-card shadow-sm">
    <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
        <img src="@(Model.CoverThumbnailUrl ?? "/img/no-photo.svg")" alt="@Model.Name" class="card-img-top" loading="lazy"
             onerror="this.onerror=null;this.src='/img/no-photo.svg';" />
    </a>
    <div class="card-body">
        <p class="h5 mb-1">
            @if (Model.MonthlyRent is { } rent)
            {
                <span>@Currency.Rand(rent)</span><span class="fs-6 text-muted"> / month</span>
            }
            else
            {
                <span class="fs-6 text-muted">Rent on request</span>
            }
        </p>
        <h2 class="h6 mb-1">
            <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link text-body text-decoration-none">@Model.Name</a>
        </h2>
        <p class="text-muted small mb-0">@Model.Suburb · @(Model.PhotoCount == 1 ? "1 photo" : $"{Model.PhotoCount} photos")</p>
    </div>
</div>
