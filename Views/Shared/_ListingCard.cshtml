@model ZeeAcom.Common.Models.ListingModels.ListingModel
@* One property in the public listings grid. *@
<div class="card h-100 listing-card">
    <div class="listing-photo">
        <img src="@(Model.CoverThumbnailUrl ?? "/img/no-photo.svg")" alt="@Model.Name" class="card-img-top" loading="lazy"
             onerror="this.onerror=null;this.src='/img/no-photo.svg';" />
        <span class="listing-price">
            @if (Model.MonthlyRent is { } rent)
            {
                @Currency.Rand(rent)<small> /month</small>
            }
            else
            {
                <small>Rent on request</small>
            }
        </span>
        @if (Model.PhotoCount > 1)
        {
            <span class="listing-photos-count"><i class="bi bi-images me-1" aria-hidden="true"></i>@Model.PhotoCount</span>
        }
    </div>
    <div class="card-body">
        <h2 class="h6 mb-1">
            <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link text-body text-decoration-none">@Model.Name</a>
        </h2>
        <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@Model.Suburb</p>
    </div>
</div>
