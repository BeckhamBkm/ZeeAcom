@using Microsoft.AspNetCore.Identity
@using ZeeAcom.Common.Entities
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-md-center gap-2 mt-2 mt-md-0">
    @if (SignInManager.IsSignedIn(User))
    {
        var email = User.Identity?.Name ?? "";
        var initial = email.Length > 0 ? char.ToUpperInvariant(email[0]).ToString() : "?";
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="za-avatar za-avatar-green">@initial</span>
                <span class="small text-truncate za-user-email">@email</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                @if (User.IsInRole(ZeeAcom.Common.Roles.Landlord))
                {
                    <li><a class="dropdown-item" asp-controller="Landlord" asp-action="Index"><i class="bi bi-grid-1x2 me-2" aria-hidden="true"></i>Dashboard</a></li>
                    <li><a class="dropdown-item" asp-controller="Landlord" asp-action="Enquiries"><i class="bi bi-chat-dots me-2" aria-hidden="true"></i>Enquiries</a></li>
                    <li><hr class="dropdown-divider" /></li>
                }
                <li>
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Log out</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
        <li class="nav-item"><a class="btn btn-accent btn-sm px-3" asp-controller="Account" asp-action="Register">List your place</a></li>
    }
</ul>
