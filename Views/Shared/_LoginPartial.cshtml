@using Microsoft.AspNetCore.Identity
@using ZeeAcom.Common.Entities
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="navbar-text me-3 small">@User.Identity?.Name</span>
        </li>
        <li class="nav-item">
            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
    }
</ul>
