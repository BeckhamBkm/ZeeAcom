@model PropertyFormViewModel
@* Name/address/suburb/rent/active fields shared by the landlord add/edit form and the admin edit form. *@

<div class="mb-3">
    <label asp-for="Name" class="form-label">Name</label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Garden Cottage" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Address" class="form-label">Street address</label>
    <input asp-for="Address" class="form-control" autocomplete="street-address" />
    <span asp-validation-for="Address" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Suburb" class="form-label">Suburb / area</label>
    <input asp-for="Suburb" class="form-control" placeholder="e.g. Zeerust CBD" />
    <span asp-validation-for="Suburb" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="MonthlyRent" class="form-label">Monthly rent</label>
    <div class="input-group">
        <span class="input-group-text">R</span>
        <input asp-for="MonthlyRent" type="number" min="0" step="0.01" class="form-control" placeholder="e.g. 2500" />
    </div>
    <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="Active" class="form-check-input" />
    <label asp-for="Active" class="form-check-label">Available (show this property in listings)</label>
</div>
