@model IEnumerable<ZeeAcom.Common.Models.EnquiryModels.EnquiryModel>
@{
    ViewData["Title"] = "Enquiries";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Enquiries</li>
    </ol>
</nav>

<div class="page-head">
    <div>
        <h1 class="h2">Enquiries</h1>
        <p class="text-muted mb-0">People who contacted you through your listings. Reply on WhatsApp, by phone or by email.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-chat-dots" aria-hidden="true"></i>
        No enquiries yet. They'll appear here when someone contacts you through one of your listings.
    </div>
}
else
{
    <div class="vstack gap-3">
        @foreach (var enquiry in Model)
        {
            var whatsApp = PhoneLinks.WhatsApp(enquiry.CellPhone, $"Hi {enquiry.Name}, thanks for your enquiry about {enquiry.PropertyName} on Zee Accom.");
            var call = PhoneLinks.Tel(enquiry.CellPhone);
            <div class="card">
                <div class="card-body d-flex gap-3">
                    <span class="za-avatar za-avatar-lg d-none d-sm-inline-flex">@Avatar.Initials(enquiry.Name)</span>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex justify-content-between flex-wrap gap-2 mb-1">
                            <div>
                                <span class="fw-bold">@enquiry.Name</span>
                                <span class="text-muted">about</span>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@enquiry.PropertyId" class="fw-semibold">@enquiry.PropertyName</a>
                            </div>
                            <span class="text-muted small" title="@enquiry.DateCreated.ToLocalTime().ToString("d MMM yyyy, HH:mm")">@TimeAgo.From(enquiry.DateCreated)</span>
                        </div>
                        <p class="mb-3" style="white-space: pre-line">@enquiry.Message</p>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @if (whatsApp is not null)
                            {
                                <a href="@whatsApp" class="btn btn-sm btn-whatsapp" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-1" aria-hidden="true"></i>WhatsApp</a>
                            }
                            @if (call is not null)
                            {
                                <a href="@call" class="btn btn-sm btn-light-soft"><i class="bi bi-telephone me-1" aria-hidden="true"></i>@enquiry.CellPhone</a>
                            }
                            else
                            {
                                <span class="small">@enquiry.CellPhone</span>
                            }
                            @if (enquiry.Email is not null)
                            {
                                <a href="mailto:@enquiry.Email" class="btn btn-sm btn-light-soft text-truncate" style="max-width: 100%"><i class="bi bi-envelope me-1" aria-hidden="true"></i>@enquiry.Email</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
