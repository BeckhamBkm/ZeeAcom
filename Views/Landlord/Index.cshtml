@model LandlordDashboardViewModel
@{
    ViewData["Title"] = "My listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Hi, @Model.Owner.FirstName</h1>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">My details</div>
            <div class="card-body">
                <p class="mb-1 fw-semibold">@Model.Owner.FirstName @Model.Owner.LastName</p>
                <p class="mb-1">@Model.Owner.CellPhone</p>
                <p class="mb-0">@Model.Owner.Email</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <h2 class="h5">My properties</h2>
        @if (!Model.Properties.Any())
        {
            <p class="text-muted">You haven't listed any properties yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Suburb</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.Properties)
                        {
                            <tr>
                                <td>@property.Name</td>
                                <td>@property.Address</td>
                                <td>@property.Suburb</td>
                                <td>
                                    @if (property.Active)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="text-muted small">Adding and editing your own properties and rooms is coming next.</p>
    </div>
</div>
