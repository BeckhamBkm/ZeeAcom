@model LandlordDashboardViewModel
@{
    ViewData["Title"] = "My listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Hi, @Model.Owner.FirstName</h1>
    <a class="btn btn-primary" asp-action="AddProperty">Add property</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">My details</div>
            <div class="card-body">
                <p class="mb-1 fw-semibold">@Model.Owner.FirstName @Model.Owner.LastName</p>
                <p class="mb-1">@Model.Owner.CellPhone</p>
                <p class="mb-0">@Model.Owner.Email</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <h2 class="h5">My properties</h2>
        @if (!Model.Properties.Any())
        {
            <div class="border rounded p-4 text-center text-muted">
                <p class="mb-3">You haven't listed any properties yet.</p>
                <a class="btn btn-outline-primary" asp-action="AddProperty">Add your first property</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Suburb</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.Properties)
                        {
                            <tr>
                                <td>@property.Name</td>
                                <td>@property.Address</td>
                                <td>@property.Suburb</td>
                                <td>
                                    @if (property.Active)
                                    {
                                        <span class="badge text-bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Not available</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="EditProperty" asp-route-id="@property.Id">Edit</a>
                                    <form method="post" asp-action="DeleteProperty" asp-route-id="@property.Id" class="d-inline"
                                          onsubmit="return confirm('Delete this property? This can\'t be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="text-muted small">Rooms and photos for each property are coming next.</p>
    </div>
</div>
