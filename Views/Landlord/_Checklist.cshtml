@model LandlordDashboardViewModel
@* Getting-started steps on the landlord dashboard (shown until they're all done). *@
@{
    var checklist = Model.Checklist;
    var stepsDone = checklist.Count(c => c.Done);
}
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Getting started</h2>
            <span class="small text-muted">@stepsDone of @checklist.Count</span>
        </div>
        <div class="progress mb-2" role="progressbar" aria-label="Getting started progress"
             aria-valuenow="@stepsDone" aria-valuemin="0" aria-valuemax="@checklist.Count">
            <div class="progress-bar" style="width: @(stepsDone * 100 / checklist.Count)%"></div>
        </div>
        <ul class="checklist">
            @foreach (var step in checklist)
            {
                <li class="@(step.Done ? "done" : "")">
                    <span class="check-dot"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
                    <div>
                        <div class="check-title">@step.Title<span class="visually-hidden">@(step.Done ? " (done)" : " (to do)")</span></div>
                        @if (!step.Done)
                        {
                            <div class="small text-muted">@step.Hint</div>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
