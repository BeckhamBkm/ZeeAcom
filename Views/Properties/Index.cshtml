@model PropertyIndexViewModel
@{
    ViewData["Title"] = "Properties";
    var selectedOwner = Model.OwnerOptions.FirstOrDefault(o => o.Selected)?.Text;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">
        Properties
        @if (selectedOwner is not null)
        {
            <small class="text-muted fs-6">owned by @selectedOwner</small>
        }
    </h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-ownerId="@Model.OwnerId">Add property</a>
</div>

<form method="get" asp-action="Index" class="filter-bar row g-2 mx-0 mb-4">
    <div class="col-md-3">
        <input asp-for="Name" class="form-control" placeholder="Name" />
    </div>
    <div class="col-md-2">
        <input asp-for="Suburb" class="form-control" placeholder="Suburb" />
    </div>
    <div class="col-md-3">
        <select asp-for="OwnerId" asp-items="Model.OwnerOptions" class="form-select">
            <option value="">All owners</option>
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Active" class="form-select">
            <option value="">Any status</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Properties.Any())
{
    <p class="text-muted">No properties found.</p>
}
else
{
    <div class="table-responsive table-card mb-3">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Suburb</th>
                    <th>Owner</th>
                    <th class="text-end">Rent / month</th>
                    <th>Status</th>
                    <th>Added</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model.Properties)
                {
                    <tr>
                        <td><partial name="_CoverThumb" model="property" /></td>
                        <td>@if (property.IsPublic) { <a asp-controller="Listings" asp-action="Details" asp-route-id="@property.Id" title="View public listing">@property.Name</a> } else { @property.Name }</td>
                        <td>@property.Address</td>
                        <td>@property.Suburb</td>
                        <td>
                            <a asp-action="Index" asp-route-ownerId="@property.OwnerId">@property.Owner?.FirstName @property.Owner?.LastName</a>
                        </td>
                        <td class="text-end text-nowrap">@(property.MonthlyRent is { } rent ? Currency.Rand(rent) : "—")</td>
                        <td>
                            @if (property.Active)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                            @if (property.HiddenByAdmin)
                            {
                                <span class="badge text-bg-danger">Hidden by admin</span>
                            }
                            @if (property.Owner is { Status: not OwnerStatus.Approved } owner)
                            {
                                <span title="Owner status"><partial name="_OwnerStatusBadge" model="owner.Status" /></span>
                            }
                        </td>
                        <td>@(property.DateCreated == default ? "—" : property.DateCreated.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-primary" asp-controller="Photos" asp-action="Index" asp-route-propertyId="@property.Id">Photos (@property.PhotoCount)</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@property.Id">Edit</a>
                            <form method="post" asp-action="SetHidden" asp-route-id="@property.Id" asp-route-ownerId="@Model.OwnerId" class="d-inline">
                                <input type="hidden" name="hidden" value="@(property.HiddenByAdmin ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(property.HiddenByAdmin ? "Unhide" : "Hide")</button>
                            </form>
                            <form method="post" asp-action="Delete" asp-route-id="@property.Id" asp-route-ownerId="@Model.OwnerId"
                                  class="d-inline" onsubmit="return confirm('Delete this property and its photos?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Property pages">
            <ul class="pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-name="@Model.Name"
                           asp-route-suburb="@Model.Suburb" asp-route-ownerId="@Model.OwnerId"
                           asp-route-active="@Model.Active">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <p class="text-muted small">@Model.Total @(Model.Total == 1 ? "property" : "properties")</p>
}
