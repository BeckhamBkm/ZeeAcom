@model ZeeAcom.Common.Models.AccountModels.RegisterLandlordModel
@{
    ViewData["Title"] = "Register as a landlord";
}

<div class="auth-wrap">
    <div class="card overflow-hidden">
        <div class="row g-0">
            <partial name="_AuthSide" />
            <div class="col-lg-7">
                <div class="p-4 p-md-5">
                    <div class="eyebrow mb-1">For landlords</div>
                    <h1 class="h3 mb-1">List your place on Zee Accom</h1>
                    <p class="text-muted mb-4">Create your free account. You can add properties and photos straight away.</p>

                    <form method="post" asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="CellPhone" class="form-label"></label>
                                <input asp-for="CellPhone" class="form-control" autocomplete="tel" placeholder="e.g. 082 123 4567" />
                                <span asp-validation-for="CellPhone" class="text-danger small"></span>
                                <div class="form-text">Renters contact you on this number (WhatsApp and calls).</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-text">At least 8 characters, with upper- and lower-case letters and a number.</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 mt-4">Create my free account</button>
                        <p class="mt-4 mb-0 text-center text-muted">Already registered? <a asp-action="Login" class="fw-semibold">Log in</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
