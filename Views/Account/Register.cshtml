@model ZeeAcom.Common.Models.AccountModels.RegisterLandlordModel
@{
    ViewData["Title"] = "Register as a landlord";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-1">Register as a landlord</h1>
        <p class="text-muted mb-4">List your rooms and properties in Zeerust so tenants can find and contact you.</p>

        <form method="post" asp-action="Register">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="CellPhone" class="form-label"></label>
                    <input asp-for="CellPhone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="CellPhone" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="form-text">At least 8 characters, with upper- and lower-case letters and a number.</div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-4">Create account</button>
            <p class="mt-3 small">Already registered? <a asp-action="Login">Log in</a></p>
        </form>
    </div>
</div>
