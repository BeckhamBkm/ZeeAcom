@model RoomFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add room" : $"Edit {Model.Room.Name}";
}

<h1 class="h3 mb-1">@(isNew ? "Add a room" : "Edit room")</h1>
<p class="text-muted mb-3">@Model.PropertyName</p>

<form method="post" asp-action="@(isNew ? "Add" : "Edit")" asp-route-propertyId="@Model.PropertyId" asp-route-id="@Model.Id" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Room.Name" class="form-label">Room name</label>
        <input asp-for="Room.Name" class="form-control" placeholder="e.g. Room 1, Bachelor flat, Back room" />
        <span asp-validation-for="Room.Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Room.MonthlyRent" class="form-label">Monthly rent</label>
        <div class="input-group">
            <span class="input-group-text">R</span>
            <input asp-for="Room.MonthlyRent" type="number" min="0" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="Room.MonthlyRent" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Room.Description" class="form-label">Description <span class="text-muted small">(optional)</span></label>
        <textarea asp-for="Room.Description" rows="3" class="form-control"
                  placeholder="e.g. En-suite, furnished, water and electricity included"></textarea>
        <span asp-validation-for="Room.Description" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Room.Available" class="form-check-input" />
        <label asp-for="Room.Available" class="form-check-label">Available to rent</label>
    </div>

    <button type="submit" class="btn btn-primary">@(isNew ? "Add room" : "Save changes")</button>
    <a asp-action="Index" asp-route-propertyId="@Model.PropertyId" class="btn btn-outline-secondary">Cancel</a>
</form>
