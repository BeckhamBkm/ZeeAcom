@model RoomsPageViewModel
@{
    ViewData["Title"] = $"Rooms - {Model.Property.Name}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        @if (Model.IsAdmin)
        {
            <li class="breadcrumb-item"><a asp-controller="Properties" asp-action="Index" asp-route-ownerId="@Model.Property.OwnerId">Properties</a></li>
        }
        else
        {
            <li class="breadcrumb-item"><a asp-controller="Landlord" asp-action="Index">My listings</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Property.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Property.Name</h1>
        <p class="text-muted mb-0">
            @Model.Property.Address, @Model.Property.Suburb
            @if (Model.IsAdmin && Model.Property.Owner is not null)
            {
                <span> · Owner: @Model.Property.Owner.FirstName @Model.Property.Owner.LastName</span>
            }
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Add" asp-route-propertyId="@Model.Property.Id">Add room</a>
</div>

@if (!Model.Rooms.Any())
{
    <div class="border rounded p-4 text-center text-muted">
        <p class="mb-3">No rooms yet. Add each room (or unit) you rent out, with its monthly rent.</p>
        <a class="btn btn-outline-primary" asp-action="Add" asp-route-propertyId="@Model.Property.Id">Add the first room</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Room</th>
                    <th class="text-end">Rent / month</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td class="fw-semibold">@room.Name</td>
                        <td class="text-end text-nowrap">@Currency.Rand(room.MonthlyRent)</td>
                        <td>
                            @if (room.Available)
                            {
                                <span class="badge text-bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Taken</span>
                            }
                        </td>
                        <td class="small text-muted">@room.Description</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-propertyId="@Model.Property.Id" asp-route-id="@room.Id">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-propertyId="@Model.Property.Id" asp-route-id="@room.Id" class="d-inline"
                                  onsubmit="return confirm('Delete this room?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        @Model.Rooms.Count() room(s), @Model.Rooms.Count(r => r.Available) available
    </p>
}
